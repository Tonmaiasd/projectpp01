# ==================================================
# FRONTEND (Vite) — ใส่ใน Vercel > Settings > Environment Variables
# ==================================================
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL ของ Backend ที่ deploy บน Render
# ตัวอย่าง: https://your-app-name.onrender.com
VITE_SERVER_URL=https://your-app-name.onrender.com

# ==================================================
# BACKEND (server.js) — ใส่ใน Render > Environment
# ==================================================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_DEFAULT_TO=your_line_user_id_or_group_id
# PORT จะถูก Render ตั้งค่าให้อัตโนมัติ ไม่ต้องใส่เอง
